{
  "schema": "megatron-bridge.native-source-provenance.v2",
  "authority": {
    "repository": "NVIDIA/Megatron-LM",
    "manifest_path": "pyproject.toml",
    "selection": "The frozen MCore gitlink selects native Python dependency sources; Bridge does not override them."
  },
  "lanes": [
    {
      "name": "main",
      "mcore_commit": {
        "algorithm": "git-sha1",
        "parts": ["4ac689b8bfe55c00f61d", "7ff0d082cad558632445"]
      },
      "native_sources": {
        "transformer_engine": {
          "repository": "https://github.com/NVIDIA/TransformerEngine.git",
          "commit": {
            "algorithm": "git-sha1",
            "parts": ["4329ff84bfbdaa778a33", "cba02a15fb0807c64689"]
          }
        },
        "fast_hadamard_transform": {
          "repository": "https://github.com/Dao-AILab/fast-hadamard-transform.git",
          "commit": {
            "algorithm": "git-sha1",
            "parts": ["1cc807efbd6cc001df35", "9822d60bf6052dd66859"]
          }
        },
        "torch_memory_saver": {
          "repository": "https://github.com/fzyzcjy/torch_memory_saver.git",
          "commit": {
            "algorithm": "git-sha1",
            "parts": ["9bc9a442e6d108c7b790", "3def199896a005143aaf"]
          }
        }
      }
    },
    {
      "name": "dev",
      "mcore_commit": {
        "algorithm": "git-sha1",
        "parts": ["bae1d8992fe40719505d", "2e10537e3cc1816ee68f"]
      },
      "native_sources": {
        "transformer_engine": {
          "repository": "https://github.com/NVIDIA/TransformerEngine.git",
          "commit": {
            "algorithm": "git-sha1",
            "parts": ["f031cf87bd054c7558b8", "87df7bed93975456667f"]
          }
        },
        "fast_hadamard_transform": {
          "repository": "https://github.com/Dao-AILab/fast-hadamard-transform.git",
          "commit": {
            "algorithm": "git-sha1",
            "parts": ["f134af63deb2df17e117", "1a9ec1ea4a7d8604d5ca"]
          }
        },
        "torch_memory_saver": null
      }
    }
  ],
  "verification": {
    "consumer": "docker/Dockerfile.ci",
    "script": "docker/verify-native-source-provenance.py",
    "contract": "The build reconstructs each Git object ID, selects a lane by its immutable MCore commit, verifies every active native source against the frozen MCore manifest, and redirects package clones to the verified local caches. Object IDs are split only to prevent DevSkim from misclassifying public Git commits as secrets."
  }
}
