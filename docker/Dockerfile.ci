ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.06-py3
FROM ${BASE_IMAGE} AS megatron_bridge
WORKDIR /opt/Megatron-Bridge

ARG APPLY_PYTORCH_LIBRARY_FINALIZER_PATCH=True

RUN --mount=type=bind,source=docker/patches/pytorch-library-finalizer.patch,target=/opt/pytorch-library-finalizer.patch \
    if [ "$APPLY_PYTORCH_LIBRARY_FINALIZER_PATCH" != "True" ]; then exit 0; fi; \
    TORCH_SITE_PACKAGES=$(python -c 'from pathlib import Path; import torch.library; print(Path(torch.library.__file__).parent.parent)') && \
    patch -d "${TORCH_SITE_PACKAGES}" -p1 < /opt/pytorch-library-finalizer.patch && \
    python - <<'PY'
import torch
from torch.library import Library, _clear_torch_ops_cache

namespace_name = "_mbridge_finalizer_test"
library = Library(namespace_name, "DEF")
library.define("uncached_op() -> None")
namespace = getattr(torch.ops, namespace_name)
original_getattr = type(namespace).__getattr__


def fail_getattr(self, name):
    raise AssertionError(f"Torch op cache cleanup called __getattr__ for {name}")


type(namespace).__getattr__ = fail_getattr
try:
    _clear_torch_ops_cache({f"{namespace_name}::uncached_op"})
finally:
    type(namespace).__getattr__ = original_getattr
PY

ARG INSTALL_DEEPEP=True
ARG DEEPEP_COMMIT=34152ae28f80bcc3ee38d7a12cb2ad87cfd4ea72
ARG REINSTALL_NVSHMEM=True

ENV PATH="/opt/venv/bin:/usr/local/bin:$PATH" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    UV_LINK_MODE=copy \
    UV_VERSION="0.7.2" \
    UV_HTTP_TIMEOUT=120 \
    NVTE_BUILD_NUM_PHILOX_ROUNDS=3 \
    NVTE_SKIP_SUBMODULE_CHECKS_DURING_BUILD=1 \
    FAST_HADAMARD_TRANSFORM_FORCE_BUILD=TRUE \
    HYBRID_EP_MULTINODE=1 \
    RDMA_CORE_HOME=/opt/rdma-core/build \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64/:$LD_LIBRARY_PATH"

##############################################################################
##
## Install DeepEP and nvshmem
##
##############################################################################

RUN --mount=type=bind,source=docker/patches/deepep.patch,target=/opt/deepep.patch \
    curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | sh && \
    install -m 0755 /root/.local/bin/uv /usr/local/bin/uv && \
    uv venv ${UV_PROJECT_ENVIRONMENT} --system-site-packages && \
    apt-get update && apt install -y --only-upgrade gnupg openssl libssl3t64 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    if [ "$INSTALL_DEEPEP" = "True" ]; then \
    ARCH_LIB=$(dpkg-architecture -qDEB_HOST_MULTIARCH) && \
    # libmlx5-dev is not available in the apt sources; create the unversioned
    # symlink from the versioned one as a fallback for the DeepEP build.
    test -f /usr/lib/${ARCH_LIB}/libmlx5.so || \
        ln -sf /usr/lib/${ARCH_LIB}/libmlx5.so.1 /usr/lib/${ARCH_LIB}/libmlx5.so && \
    # Expose the system install under RDMA_CORE_HOME so DeepEP setup.py finds
    # $RDMA_CORE_HOME/include and $RDMA_CORE_HOME/lib without a separate source build.
    mkdir -p ${RDMA_CORE_HOME} && \
    ln -sfn /usr/include ${RDMA_CORE_HOME}/include && \
    ln -sfn /usr/lib/${ARCH_LIB} ${RDMA_CORE_HOME}/lib && \
    git clone https://github.com/deepseek-ai/DeepEP.git && \
    pushd DeepEP && \
        git pull && \
        git fetch origin $DEEPEP_COMMIT && \
        git checkout FETCH_HEAD && \
        patch -p1 < /opt/deepep.patch && \
        if [ "$REINSTALL_NVSHMEM" = "True" ]; then \
            pip install --no-cache-dir nvidia-nvshmem-cu13==3.6.5 && \
            # Create symlink for libnvshmem_host.so (required for DeepEP fabric handle operations)
            NVSHMEM_LIB_PATH=$(pip show nvidia-nvshmem-cu13 | grep "Location:" | cut -d' ' -f2)/nvidia/nvshmem/lib && \
            ln -sf ${NVSHMEM_LIB_PATH}/libnvshmem_host.so.3 ${NVSHMEM_LIB_PATH}/libnvshmem_host.so; \
        fi && \
        apt-get update && \
        apt-get install -y --no-install-recommends libnvidia-ml-dev && \
        TORCH_CUDA_ARCH_LIST="9.0 10.0 12.0" pip install --no-cache-dir --no-build-isolation -v . && \
        apt-get purge -y libnvidia-ml-dev && \
        apt-get autoremove -y && \
        rm -rf /var/lib/apt/lists/* && \
    popd; \
    fi && \
    chown -R 1000:1000 ${UV_PROJECT_ENVIRONMENT}

COPY pyproject.toml uv.lock /opt/Megatron-Bridge/
COPY src/megatron/bridge/__init__.py src/megatron/bridge/package_info.py /opt/Megatron-Bridge/src/megatron/bridge/

# FlashMLA setup.py initializes CUTLASS during metadata/build. Materialize the audited,
# immutable submodule in the source cache so package installation is network-free.
ARG FLASH_MLA_REF=b7643bd54521f563b839b98289b5cd048c062ba2
ARG FLASH_MLA_CUTLASS_REF=147f5673d0c1c3dcf66f78d677fd647e4a020219
RUN git clone --filter=blob:none --no-checkout https://github.com/deepseek-ai/FlashMLA.git /opt/flash-mla && \
    git -C /opt/flash-mla fetch --depth 1 origin "$FLASH_MLA_REF" && \
    git -C /opt/flash-mla checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/flash-mla rev-parse HEAD)" = "$FLASH_MLA_REF" && \
    git -C /opt/flash-mla/csrc/cutlass init && \
    git -C /opt/flash-mla/csrc/cutlass remote add origin https://github.com/NVIDIA/cutlass.git && \
    git -C /opt/flash-mla/csrc/cutlass fetch --depth 1 origin "$FLASH_MLA_CUTLASS_REF" && \
    git -C /opt/flash-mla/csrc/cutlass checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/flash-mla/csrc/cutlass rev-parse HEAD)" = "$FLASH_MLA_CUTLASS_REF" && \
    git config --global url.file:///opt/flash-mla/.insteadOf https://github.com/deepseek-ai/FlashMLA && \
    git config --global url.file:///opt/flash-mla/csrc/cutlass/.insteadOf https://github.com/NVIDIA/cutlass.git

# MCore pins native packages to exact source commits. Prefetch both lane revisions, verify
# the dev FHT commit is carried by v1.1.0 and the dev TE commit is the v2.14 release target,
# then force uv's clones through these audited local caches.
ARG FAST_HADAMARD_TRANSFORM_MAIN_REF=1cc807efbd6cc001df359822d60bf6052dd66859
ARG FAST_HADAMARD_TRANSFORM_DEV_REF=f134af63deb2df17e1171a9ec1ea4a7d8604d5ca
ARG TRANSFORMER_ENGINE_MAIN_REF=4329ff84bfbdaa778a33cba02a15fb0807c64689
ARG TRANSFORMER_ENGINE_DEV_REF=f031cf87bd054c7558b887df7bed93975456667f
RUN git clone --filter=blob:none --no-checkout https://github.com/Dao-AILab/fast-hadamard-transform.git /opt/fast-hadamard-transform && \
    git -C /opt/fast-hadamard-transform fetch --depth 3 origin \
        "$FAST_HADAMARD_TRANSFORM_MAIN_REF" "$FAST_HADAMARD_TRANSFORM_DEV_REF" \
        refs/tags/v1.1.0:refs/tags/v1.1.0 && \
    test "$(git -C /opt/fast-hadamard-transform rev-parse refs/tags/v1.1.0^{commit})" = \
        "$FAST_HADAMARD_TRANSFORM_MAIN_REF" && \
    git -C /opt/fast-hadamard-transform merge-base --is-ancestor \
        "$FAST_HADAMARD_TRANSFORM_DEV_REF" "$FAST_HADAMARD_TRANSFORM_MAIN_REF" && \
    git clone --filter=blob:none --no-checkout https://github.com/NVIDIA/TransformerEngine.git /opt/transformer-engine && \
    git -C /opt/transformer-engine fetch --depth 1 origin \
        "$TRANSFORMER_ENGINE_MAIN_REF" "$TRANSFORMER_ENGINE_DEV_REF" \
        refs/tags/v2.14:refs/tags/v2.14 && \
    git -C /opt/transformer-engine cat-file -e "$TRANSFORMER_ENGINE_MAIN_REF^{commit}" && \
    test "$(git -C /opt/transformer-engine rev-parse refs/tags/v2.14^{commit})" = \
        "$TRANSFORMER_ENGINE_DEV_REF" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_MAIN_REF" 3rdparty/cudnn-frontend | awk '{print $3}')" = \
        "e46d7082450264ce05cf898f8740011c4896f817" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_DEV_REF" 3rdparty/cudnn-frontend | awk '{print $3}')" = \
        "7b9b711c22b6823e87150213ecd8449260db8610" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_MAIN_REF" 3rdparty/googletest | awk '{print $3}')" = \
        "f8d7d77c06936315286eb55f8de22cd23c188571" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_DEV_REF" 3rdparty/googletest | awk '{print $3}')" = \
        "f8d7d77c06936315286eb55f8de22cd23c188571" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_MAIN_REF" 3rdparty/cutlass | awk '{print $3}')" = \
        "57e3cfb47a2d9e0d46eb6335c3dc411498efa198" && \
    test "$(git -C /opt/transformer-engine ls-tree "$TRANSFORMER_ENGINE_DEV_REF" 3rdparty/cutlass | awk '{print $3}')" = \
        "57e3cfb47a2d9e0d46eb6335c3dc411498efa198" && \
    git config --global url.file:///opt/fast-hadamard-transform/.insteadOf \
        https://github.com/Dao-AILab/fast-hadamard-transform.git && \
    git config --global url.file:///opt/transformer-engine/.insteadOf \
        https://github.com/NVIDIA/TransformerEngine.git

ARG BASELINE_MCORE_REF

# Resolve the immutable baseline before copying the mutable dispatched checkout.
# This keeps the dependency layer independent of ordinary MCore source changes.
RUN if [ -n "$BASELINE_MCORE_REF" ]; then \
        git clone --filter=blob:none --no-checkout https://github.com/NVIDIA/Megatron-LM.git 3rdparty/Megatron-LM && \
        git -C 3rdparty/Megatron-LM fetch --depth 1 origin "$BASELINE_MCORE_REF" && \
        git -C 3rdparty/Megatron-LM checkout --detach FETCH_HEAD && \
        test "$(git -C 3rdparty/Megatron-LM rev-parse HEAD)" = "$BASELINE_MCORE_REF" && \
        test -f 3rdparty/Megatron-LM/pyproject.toml; \
    fi

# Build arg to skip --locked when testing with different MCore versions
ARG MCORE_TRIGGERED_TESTING=false
ARG UV_CACHE_PRUNE_ARGS

# Install the main-branch environment from an immutable baseline context before
# dispatched MCore metadata can invalidate this expensive dependency layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$BASELINE_MCORE_REF" ]; then \
        export MAMBA_FORCE_BUILD=TRUE CAUSAL_CONV1D_FORCE_BUILD=TRUE && \
        export TMS_CUDA_MAJOR="$("${CUDA_HOME:-/usr/local/cuda}"/bin/nvcc --version | sed -n 's/.*release \([0-9][0-9]*\).*/\1/p' | head -1)" && \
        test -n "$TMS_CUDA_MAJOR" && \
        export FLASH_MLA_DISABLE_SM90=1 NVCC_THREADS=16 \
            CFLAGS="-I/usr/local/cuda/include/cccl${CFLAGS:+ $CFLAGS} -DNDEBUG" \
            CXXFLAGS="-I/usr/local/cuda/include/cccl${CXXFLAGS:+ $CXXFLAGS} -DNDEBUG" && \
        uv sync --locked --only-group build && \
        uv sync --link-mode copy --locked --all-extras --all-groups --no-group diffusion; \
    fi

RUN rm -rf 3rdparty/Megatron-LM
COPY 3rdparty/Megatron-LM /opt/Megatron-Bridge/3rdparty/Megatron-LM

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv \
    export MAMBA_FORCE_BUILD=TRUE CAUSAL_CONV1D_FORCE_BUILD=TRUE && \
    export TMS_CUDA_MAJOR="$("${CUDA_HOME:-/usr/local/cuda}"/bin/nvcc --version | sed -n 's/.*release \([0-9][0-9]*\).*/\1/p' | head -1)" && \
    test -n "$TMS_CUDA_MAJOR" && \
    # flash-mla (Megatron-LM's no_pypi_wheels group) has no PyPI wheel and is built from source by
    # the uv sync below. Point the compilers at the CCCL/libcu++ headers (under cccl/ in this base
    # image, not the default CUDA include path) and scope the build to the target archs.
    export FLASH_MLA_DISABLE_SM90=1 NVCC_THREADS=16 \
        CFLAGS="-I/usr/local/cuda/include/cccl${CFLAGS:+ $CFLAGS} -DNDEBUG" \
        CXXFLAGS="-I/usr/local/cuda/include/cccl${CXXFLAGS:+ $CXXFLAGS} -DNDEBUG" && \
    # Reinstall nvidia-cutlass-dsl in system site packages
    # uv install can run into non-deterministic install issues
    # Keep this pin compatible with cuDNN Frontend; mismatched versions can break
    # its CUTLASS-backed kernels.
    pip uninstall -y nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base nvidia-cutlass-dsl-libs-cu13 && \
    pip install nvidia-cutlass-dsl[cu13]==4.5.0 && \
    if [ "$MCORE_TRIGGERED_TESTING" = "true" ]; then \
        echo "⚙️ MCore testing mode: syncing the dispatched dependency delta"; \
        uv sync --only-group build && \
        uv sync --link-mode copy --all-extras --all-groups --no-group diffusion; \
    elif [ -z "$BASELINE_MCORE_REF" ]; then \
        uv sync --locked --only-group build && \
        uv sync --link-mode copy --locked --all-extras --all-groups --no-group diffusion; \
    fi && \
    # uv may retain the baseline editable MCore wheel when only its source tree changes.
    # Rebuild the dispatched checkout so its optional dataset helper is present.
    uv pip install --no-deps --reinstall -e 3rdparty/Megatron-LM && \
    test -n "$(find 3rdparty/Megatron-LM/megatron/core/datasets -maxdepth 1 -name 'helpers_cpp*.so' -print -quit)" && \
    # Create symlink for tilelang's libcudart_stub.so to the actual libcudart.so
    # Otherwise, the stub will be called in some cases and fail
    ln -sf "$(ldconfig -p | awk '/libcudart\.so\.[0-9]+ /{print $NF; exit}')" /opt/venv/lib/python3.12/site-packages/tilelang/lib/libcudart_stub.so && \
    uv cache prune ${UV_CACHE_PRUNE_ARGS} && \
    chown -R 1000:1000 ${UV_PROJECT_ENVIRONMENT}

COPY scripts/install_diffusion_deps.sh scripts/diffusion-deps.lock /opt/Megatron-Bridge/scripts/

# Opt in only for CI images that run diffusion tests. Framework images must keep the default so
# CVE-carrying WAN codecs remain excluded from the shipped environment.
ARG INSTALL_DIFFUSION_DEPS=false
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INSTALL_DIFFUSION_DEPS" = "true" ]; then \
        bash scripts/install_diffusion_deps.sh; \
    fi && \
    chown -R 1000:1000 ${UV_PROJECT_ENVIRONMENT}

COPY --chown=1000:1000 . /opt/Megatron-Bridge

# CI writes coverage beside the checked-out source, installs that source editable into the
# prepared environment, and uses /nemo_run for runtime outputs. The managed CI runtime uses
# UID/GID 65532, so make that identity explicit and grant it ownership without broad permissions.
RUN printf 'mbridge:x:65532:65532:Megatron Bridge:/home/mbridge:/bin/bash\n' >> /etc/passwd && \
    printf 'mbridge:x:65532:\n' >> /etc/group && \
    install -d -o 65532 -g 65532 -m 0755 /nemo_run /home/mbridge /home/mbridge/.cache /home/ubuntu /home/ubuntu/.cache && \
    chown -R 65532:65532 /opt/venv /opt/Megatron-Bridge

ENV HOME=/home/mbridge
USER 65532:65532
