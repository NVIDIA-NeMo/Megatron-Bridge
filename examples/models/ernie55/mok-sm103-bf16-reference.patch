new file mode 100644
index 0000000000000000000000000000000000000000..150e08d8d2fb2197cdc9802930e9d9e249341453
--- /dev/null
+++ b/mok/reference_gate.py
@@ -0,0 +1,44 @@
+"""Reference arithmetic for BF16 routed SiTU experts."""
+import torch
+from torch.distributed import _functional_collectives
+import triton
+import triton.language as tl
+
+
+def scheduled_weights(workspace, schedule, weights):
+    """Collect the ten logical weights and put them in the local expert's schedule order."""
+    gathered = _functional_collectives.all_gather_tensor(
+        weights.contiguous(), gather_dim=0, group=workspace.group_name
+    )
+    packed = _functional_collectives.wait_tensor(gathered).reshape(-1)
+    peer = schedule.peer_rank.long()
+    index = schedule.peer_token_idx.long()
+    valid = (
+        (torch.arange(peer.numel(), device=peer.device) < schedule.num_tokens.reshape(()))
+        & (peer >= 0) & (peer < workspace.ep_size)
+        & (index >= 0) & (index < weights.numel())
+    )
+    linear = torch.where(valid, peer * weights.numel() + index, 0)
+    return torch.where(valid, packed[linear], 0.0).contiguous()
+
+
+@triton.jit
+def _ordered_sum(values, routes, out, width: tl.constexpr, k: tl.constexpr, block: tl.constexpr):
+    row = tl.program_id(0)
+    channel = tl.program_id(1) * block + tl.arange(0, block)
+    accumulator = tl.full((block,), 0., tl.float32)
+    for slot in tl.static_range(k):
+        expert = tl.load(routes + row*k + slot)
+        branch = tl.load(values + (row*k+slot)*width + channel,
+                         mask=(channel < width) & (expert >= 0), other=0.)
+        accumulator = (accumulator + branch.to(tl.float32)).to(tl.bfloat16).to(tl.float32)
+    tl.store(out + row*width + channel, accumulator, mask=channel < width)
+
+
+def ordered_sum(values, routes):
+    """Merge preweighted BF16 contributions in the original logical selector's slot order."""
+    n, k = routes.shape
+    width = values.shape[-1]
+    out = torch.empty((n,width), dtype=values.dtype, device=values.device)
+    _ordered_sum[(n,triton.cdiv(width,256))](values, routes, out, width, k, 256)
+    return out
diff --git a/scripts/make_strict_situ_table.py b/scripts/make_strict_situ_table.py
new file mode 100644
index 0000000000000000000000000000000000000000..c624733f12b2596bc74e59716b7340decd81fa90
--- /dev/null
+++ b/scripts/make_strict_situ_table.py
@@ -0,0 +1,35 @@
+"""Embed the three FP32 elementary function values of ERNIE's BF16 SiTU on SM103."""
+from pathlib import Path
+import hashlib
+import sys
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
+
+
+@triton.jit
+def materialize(out, BLOCK: tl.constexpr):
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    x = i.to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)
+    tl.store(out + i, libdevice.tanh(x * 0.25))
+    tl.store(out + 65536 + i, libdevice.tanh(x * 0.04))
+    tl.store(out + 131072 + i, libdevice.div_rn(1.0, 1.0 + libdevice.exp(-x)))
+
+
+def main():
+    dest = Path(sys.argv[1])
+    assert torch.cuda.get_device_capability() == (10, 3), "generate the oracle table on GB300"
+    table = torch.empty(3 * 65536, dtype=torch.float32, device="cuda")
+    materialize[(256,)](table, 256)
+    values = table.cpu().numpy().view("uint32")
+    assert values[0] == values[65536] == 0 and values[131072] == 0x3f000000
+    print("table-bytes", values.nbytes, "table-sha256", hashlib.sha256(values.tobytes()).hexdigest(), flush=True)
+    with dest.open("w") as out:
+        for start in range(0, len(values), 12):
+            out.write(", ".join(f"0x{x:08x}u" for x in values[start:start + 12]) + ",\n")
+
+
+if __name__ == "__main__":
+    main()
