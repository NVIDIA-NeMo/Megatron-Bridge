index 0000000000000000000000000000000000000000..a3c0f685b896f73c0e712b7919886e80cad6111b
--- /dev/null
+++ b/csrc/strict_situ.cuh
@@ -0,0 +1,44 @@
+#pragma once
+#include <cuda_runtime.h>
+
+// ERNIE beta=(4,25). BF16 operands arrive as exactly widened FP32 values.
+// The table is global memory, not a 768-KiB allocation in the constant segment.
+namespace reference_situ {
+static __device__ unsigned int elementary_bits[3 * 65536] = {
+#include "strict_situ_table.inc"
+};
+
+struct Values {
+    float gate_tanh, up_tanh, sigmoid;
+};
+
+static __device__ __forceinline__ Values components(float gate, float up) {
+    unsigned g = __float_as_uint(gate) >> 16;
+    unsigned u = __float_as_uint(up) >> 16;
+    return {__uint_as_float(__ldg(elementary_bits + g)),
+            __uint_as_float(__ldg(elementary_bits + 65536 + u)),
+            __uint_as_float(__ldg(elementary_bits + 131072 + g))};
+}
+
+static __device__ __forceinline__ float forward(float gate, float up) {
+    Values v = components(gate, up);
+    return __fmul_rn(__fmul_rn(__fmul_rn(4.0f, v.gate_tanh), v.sigmoid),
+                     __fmul_rn(25.0f, v.up_tanh));
+}
+
+static __device__ __forceinline__ float backward(float gate, float up, float dy, float &d_gate, float &d_up) {
+    Values v = components(gate, up);
+    const float a = __fmul_rn(4.0f, v.gate_tanh);
+    const float b = __fmul_rn(25.0f, v.up_tanh);
+    const float g = __fmul_rn(a, v.sigmoid);
+    const float da = __fmul_rn(dy, b);
+    const float db = __fmul_rn(dy, g);
+    const float dt = __fmul_rn(__fmul_rn(da, v.sigmoid), 4.0f);
+    const float tanh_grad = __fmul_rn(__fmul_rn(dt, __fmaf_rn(-v.gate_tanh, v.gate_tanh, 1.0f)), 0.25f);
+    const float ds = __fmul_rn(da, a);
+    const float sigmoid_grad = __fmul_rn(__fmul_rn(ds, __fsub_rn(1.0f, v.sigmoid)), v.sigmoid);
+    d_gate = __fadd_rn(tanh_grad, sigmoid_grad);
+    d_up = __fmul_rn(__fmul_rn(__fmul_rn(db, 25.0f), __fmaf_rn(-v.up_tanh, v.up_tanh, 1.0f)), 0.04f);
+    return __fmul_rn(g, b);
+}
+}  // namespace reference_situ
